generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  domain      String?  @unique
  plan        Plan     @default(STARTER)
  maxUsers    Int      @default(10)
  active      Boolean  @default(true)
  trialEnds   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  projects    Project[]
  billings    Billing[]

  @@map("companies")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(CONSULTANT)
  password  String
  active    Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  timesheets Timesheet[]
  projects   ProjectUser[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  sapModule   SapModule
  client      String
  startDate   DateTime
  endDate     DateTime?
  budget      Float?
  hourlyRate  Float
  active      Boolean  @default(true)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  users      ProjectUser[]
  timesheets Timesheet[]

  @@map("projects")
}

model ProjectUser {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(CONSULTANT)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@map("project_users")
}

model Timesheet {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  date        DateTime
  hours       Float
  description String
  activity    Activity
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@map("timesheets")
}

model Billing {
  id          String   @id @default(cuid())
  companyId   String
  month       Int
  year        Int
  activeUsers Int
  amount      Float
  status      BillingStatus @default(PENDING)
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, month, year])
  @@map("billings")
}

enum Role {
  ADMIN
  COMPANY_ADMIN
  MANAGER
  CONSULTANT
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BillingStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ProjectRole {
  LEAD
  SENIOR
  CONSULTANT
  JUNIOR
}

enum SapModule {
  FI
  CO
  MM
  SD
  PP
  WM
  EWM
  HCM
  BTP
  CPI
  BASIS
  ABAP
  FIORI
  HANA
}

enum Activity {
  DEVELOPMENT
  CONFIGURATION
  TESTING
  DOCUMENTATION
  MEETING
  ANALYSIS
  SUPPORT
  TRAINING
}